"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { AnimatePresence } from "framer-motion";
import { ArrowRight, BarChart3, Sparkles, Users2, Video } from "lucide-react";
import { useAuth } from "@/components/AuthProvider";
import { PostCard } from "@/components/PostCard";
import {
  COLLECTIONS,
  createDocument,
  publicReadAuthenticatedUpdatePermissions,
  watchDocuments,
} from "@/lib/appwrite/bridge";
import { Query } from "@/lib/appwrite/client";
import { FeedTab, getFeedHighlights, getRecommendationReason, getTrendingTags, sortPostsForTab } from "@/lib/social/feed";
import { AppPost, Strand } from "@/lib/social/types";
import {
  STRAND_LABELS,
  STRAND_OPTIONS,
  buildPostSearchIndex,
  normalizePost,
  parseTagInput,
} from "@/lib/social/utils";
import { deleteMediaAsset, uploadMediaAsset } from "@/lib/media/client";

const feedTabs: { value: FeedTab; label: string; description: string }[] = [
  { value: "for-you", label: "For You", description: "Relevance based on people, strands, and momentum." },
  { value: "following", label: "Following", description: "Latest updates from your network." },
  { value: "trending", label: "Trending", description: "Posts pulling the most discussion." },
  { value: "latest", label: "Latest", description: "Newest posts across the community." },
];

export default function Home() {
  const { user, profile } = useAuth();
  const [posts, setPosts] = useState<AppPost[]>([]);
  const [followingIds, setFollowingIds] = useState<string[]>([]);
  const [blockedIds, setBlockedIds] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState<FeedTab>("for-you");
  const [selectedTag, setSelectedTag] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);
  const [publishing, setPublishing] = useState(false);
  const [isPoll, setIsPoll] = useState(false);
  const [pollQuestion, setPollQuestion] = useState("");
  const [pollOptionsInput, setPollOptionsInput] = useState("");

  useEffect(() => {
    return watchDocuments(
      COLLECTIONS.posts,
      [Query.orderDesc("created_at_ms"), Query.limit(80)],
      (document) => normalizePost(document.$id, document),
      (nextPosts) => {
        setPosts(nextPosts);
        setLoading(false);
      },
      () => setLoading(false),
    );
  }, []);

  useEffect(() => {
    if (!user) {
      setFollowingIds([]);
      return;
    }

    return watchDocuments(
      COLLECTIONS.follows,
      [Query.equal("follower_id", user.$id), Query.limit(200)],
      (document) => String(document.followee_id || ""),
      (nextFollowing) => setFollowingIds(nextFollowing.filter(Boolean)),
      () => setFollowingIds([]),
    );
  }, [user]);

  useEffect(() => {
    if (!user) {
      setBlockedIds([]);
      return;
    }

    return watchDocuments(
      COLLECTIONS.blocks,
      [Query.equal("blocker_id", user.$id), Query.limit(200)],
      (document) => String(document.blocked_id || ""),
      (nextBlocked) => setBlockedIds(nextBlocked.filter(Boolean)),
      () => setBlockedIds([]),
    );
  }, [user]);

  const preferredStrands = profile?.interests ?? ["S"];
  const feedContext = {
    userId: user?.$id,
    followingIds,
    preferredStrands,
  };

  const highlights = getFeedHighlights(posts);
  const trendingTags = getTrendingTags(posts);
  const rankedPosts = sortPostsForTab(posts, activeTab, feedContext);
  const visiblePosts = rankedPosts.filter((post) => {
    if (selectedTag && !post.tags.includes(selectedTag)) return false;
    if (blockedIds.includes(post.author_id)) return false;
    return true;
  });
  const strandCounts = STRAND_OPTIONS.map((strand) => ({
    ...strand,
    count: posts.filter((post) => post.strand === strand.value).length,
  }));

  async function handlePostSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setNotice(null);

    if (!user || !profile) {
      setNotice("You need an Appwrite-backed account to publish.");
      return;
    }

    const formData = new FormData(event.currentTarget);
    const title = String(formData.get("title") || "").trim();
    const body = String(formData.get("body") || "").trim();
    const strand = String(formData.get("strand") || "S") as Strand;
    const tags = parseTagInput(String(formData.get("tags") || ""));
    const image = formData.get("image");
    const video = formData.get("video");
    const createdAt = Date.now();

    if (title.length < 4 && !isPoll) {
      setNotice("Use a title with at least 4 characters.");
      return;
    }

    if (body.length < 20 && !isPoll) {
      setNotice("Give people enough context with at least 20 characters.");
      return;
    }

    const pollOptions = isPoll
      ? pollOptionsInput.split(",").map((o) => o.trim()).filter(Boolean)
      : [];

    if (isPoll && (!pollQuestion.trim() || pollOptions.length < 2)) {
      setNotice("Add a poll question and at least 2 options.");
      return;
    }

    if (isPoll && !title.trim()) {
      setNotice("Add a title for your poll post.");
      return;
    }

    setPublishing(true);

    let uploadedMediaId = "";
    let uploadedMediaStorageKey = "";
    let uploadedMediaUrl = "";
    let uploadedVideoId = "";
    let uploadedVideoStorageKey = "";
    let uploadedVideoUrl = "";

    try {
      if (image instanceof File && image.size > 0) {
        const uploaded = await uploadMediaAsset(image, { purpose: "post", visibility: "public" });
        uploadedMediaId = uploaded.mediaId;
        uploadedMediaStorageKey = uploaded.storageKey;
        uploadedMediaUrl = uploaded.publicUrl;
      }

      if (video instanceof File && video.size > 0) {
        const uploaded = await uploadMediaAsset(video, { purpose: "post", visibility: "public" });
        uploadedVideoId = uploaded.mediaId;
        uploadedVideoStorageKey = uploaded.storageKey;
        uploadedVideoUrl = uploaded.publicUrl;
      }

      const pollVotes: Record<string, string[]> = {};
      if (isPoll) {
        pollOptions.forEach((opt) => { pollVotes[opt] = []; });
      }

      await createDocument(
        COLLECTIONS.posts,
        {
          title: title || (isPoll ? pollQuestion.trim() : "Poll"),
          body: body || (isPoll ? pollQuestion.trim() : ""),
          strand,
          tags,
          search_index: buildPostSearchIndex({
            title,
            body,
            author_name: profile.full_name,
            author_role: profile.role,
            tags,
            strand,
          }),
          image_file_id: "",
          image_media_id: uploadedMediaId,
          image_media_storage_key: uploadedMediaStorageKey,
          image_media_url: uploadedMediaUrl,
          image_url: uploadedMediaUrl,
          video_url: uploadedVideoUrl,
          video_file_id: uploadedVideoId,
          video_media_id: uploadedVideoId,
          video_media_storage_key: uploadedVideoStorageKey,
          is_poll: isPoll,
          poll_question: isPoll ? pollQuestion.trim() : "",
          poll_options: pollOptions,
          poll_votes: pollVotes,
          author_id: user.$id,
          author_name: profile.full_name,
          author_role: profile.role,
          author_avatar_file_id: profile.avatar_file_id || "",
          author_avatar_media_id: profile.avatar_media_id || "",
          author_avatar_media_storage_key: profile.avatar_media_storage_key || "",
          author_avatar_media_url: profile.avatar_media_url || "",
          author_avatar_url: profile.avatar_url || "",
          likes: [],
          likes_count: 0,
          comments_count: 0,
          created_at_ms: createdAt,
          updated_at_ms: createdAt,
        },
        publicReadAuthenticatedUpdatePermissions(user.$id),
      );

      event.currentTarget.reset();
      setIsPoll(false);
      setPollQuestion("");
      setPollOptionsInput("");
      setSelectedTag(null);
      setActiveTab("latest");
      setNotice("Your post is live.");
    } catch (error) {
      if (uploadedMediaId) void deleteMediaAsset(uploadedMediaId).catch(() => {});
      if (uploadedVideoId) void deleteMediaAsset(uploadedVideoId).catch(() => {});
      setNotice(error instanceof Error ? error.message : "Publishing failed.");
      console.error(error);
    } finally {
      setPublishing(false);
    }
  }

  return (
    <>
      <section className="hero card" id="feed">
        <div className="hero-content">
          <p className="eyebrow">Bridge on Appwrite</p>
          <h1>Build a movement, not just a post.</h1>
          <p className="lead">
            The social layer now runs on Appwrite Auth, Databases, Storage, and Realtime instead of Firebase.
          </p>

          <div className="hero-meta">
            <div>
              <p className="meta-label">Active Creators</p>
              <p className="meta-value">{highlights.authorCount || 0}</p>
            </div>
            <div>
              <p className="meta-label">Reactions + Replies</p>
              <p className="meta-value">{highlights.totalEngagement}</p>
            </div>
            <div>
              <p className="meta-label">Leading Strand</p>
              <p className="meta-value">{highlights.dominantStrand}</p>
            </div>
          </div>

          <div className="hero-actions">
            <a href="#compose" className="primary" style={{ display: "inline-flex", alignItems: "center", gap: 8 }}>
              Create a post <ArrowRight size={16} />
            </a>
            <Link href="/rooms" className="ghost" style={{ display: "inline-flex", alignItems: "center", gap: 8 }}>
              Explore rooms <Users2 size={16} />
            </Link>
          </div>
        </div>

        <div className="hero-visual">
          <div className="bridge-arc" />
          <div className="hero-cards">
            <div className="mini-card highlight">
              <p className="mini-title">For You feed</p>
              <p className="muted">Ranks posts by network closeness, strand fit, freshness, and engagement.</p>
            </div>
            <div className="mini-card">
              <p className="mini-title">Trending tags</p>
              <p className="muted">
                {trendingTags.length > 0
                  ? trendingTags.map((item) => `#${item.tag}`).join(" • ")
                  : "Start posting to generate live trends."}
              </p>
            </div>
            <div className="mini-card">
              <p className="mini-title">Your interests</p>
              <p className="muted">
                {(profile?.interests ?? ["S"]).map((strand) => STRAND_LABELS[strand]).join(" • ")}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section className="card" style={{ display: "grid", gap: 18 }}>
        <div className="section-header" style={{ marginBottom: 0 }}>
          <div>
            <p className="eyebrow">Pulse</p>
            <h2>What the network is organizing around</h2>
          </div>
          <div className="chip-row">
            {strandCounts.map((strand) => (
              <span className="chip" key={strand.value}>
                {strand.label}: {strand.count}
              </span>
            ))}
          </div>
        </div>

        {trendingTags.length > 0 && (
          <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
            <button
              className={`filter ${selectedTag === null ? "active" : ""}`}
              onClick={() => setSelectedTag(null)}
            >
              All tags
            </button>
            {trendingTags.map((item) => (
              <button
                key={item.tag}
                className={`filter ${selectedTag === item.tag ? "active" : ""}`}
                onClick={() => setSelectedTag(item.tag)}
              >
                #{item.tag} · {item.count}
              </button>
            ))}
          </div>
        )}
      </section>

      <section className="composer card" id="compose">
        <div className="composer-header">
          <div>
            <p className="meta-label">Share something</p>
            <p className="muted">
              Publish updates, launch ideas, attach visuals, and add tags so the Appwrite-backed algorithm can place your work.
            </p>
          </div>
          <span className="demo-badge">
            {user ? `Posting as ${profile?.full_name || user.name}` : "Sign in to unlock publishing"}
          </span>
        </div>

        <form className="composer-form" onSubmit={handlePostSubmit}>
          <input type="text" name="title" placeholder={isPoll ? "Poll title" : "What are you launching?"} required={!isPoll} disabled={!user || publishing} />

          {isPoll ? (
            <div style={{ display: "grid", gap: 10 }}>
              <input type="text" placeholder="Poll question" value={pollQuestion} onChange={e => setPollQuestion(e.target.value)} disabled={!user || publishing} />
              <input type="text" placeholder="Options, comma separated (e.g. Option A, Option B, Option C)" value={pollOptionsInput} onChange={e => setPollOptionsInput(e.target.value)} disabled={!user || publishing} />
            </div>
          ) : (
            <textarea
              name="body"
              placeholder="Share progress, ask for collaborators, or tell the story behind the work."
              required={!isPoll}
              disabled={!user || publishing}
              style={{ minHeight: 140 }}
            />
          )}

          <div className="composer-actions">
            <div className="button-row" style={{ flexWrap: "wrap" }}>
              <select name="strand" defaultValue={preferredStrands[0]} disabled={!user || publishing}>
                {STRAND_OPTIONS.map((strand) => (
                  <option key={strand.value} value={strand.value}>
                    {strand.label}
                  </option>
                ))}
              </select>
              <input
                type="text"
                name="tags"
                placeholder="Tags, comma separated"
                disabled={!user || publishing}
                style={{ minWidth: 240 }}
              />
              <input type="file" name="image" accept="image/*" disabled={!user || publishing} />
              <input type="file" name="video" accept="video/*" disabled={!user || publishing} />
              <button
                type="button"
                className={`filter ${isPoll ? "active" : ""}`}
                onClick={() => { setIsPoll(!isPoll); }}
                disabled={!user || publishing}
                style={{ display: "inline-flex", alignItems: "center", gap: 6 }}
              >
                <BarChart3 size={16} /> Poll
              </button>
            </div>

            <button type="submit" className="primary" disabled={!user || publishing}>
              {publishing ? "Publishing..." : "Publish"}
            </button>
          </div>

          {notice && <p className="notice">{notice}</p>}
        </form>
      </section>

      <section className="feed">
        <div className="feed-header">
          <div>
            <h2>Home Feed</h2>
            <p className="muted">
              {feedTabs.find((tab) => tab.value === activeTab)?.description}
            </p>
          </div>

          <div className="filter-row">
            {feedTabs.map((tab) => (
              <button
                key={tab.value}
                className={`filter ${activeTab === tab.value ? "active" : ""}`}
                onClick={() => setActiveTab(tab.value)}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        {activeTab === "following" && user && followingIds.length === 0 && (
          <div className="card" style={{ background: "rgba(44, 138, 125, 0.08)" }}>
            <p style={{ fontWeight: 700, marginBottom: 6 }}>Your following feed is empty.</p>
            <p className="muted">
              Follow a few changemakers from the profile pages and this tab will become your private signal layer.
            </p>
          </div>
        )}

        {!user && (
          <div className="card" style={{ background: "rgba(255, 255, 255, 0.8)" }}>
            <p style={{ fontWeight: 700, marginBottom: 6 }}>Sign in to personalize the algorithm.</p>
            <p className="muted">
              Bridge will still show live community posts, but your feed gets much better once it knows your interests and network.
            </p>
          </div>
        )}

        {loading ? (
          <p className="muted">Loading posts...</p>
        ) : visiblePosts.length === 0 ? (
          <p className="muted">No posts match this view yet. Try another feed tab or tag.</p>
        ) : (
          <AnimatePresence initial={false}>
            {visiblePosts.map((post) => (
              <PostCard
                key={post.id}
                post={post}
                user={user}
                insight={activeTab === "for-you" ? getRecommendationReason(post, feedContext) : undefined}
              />
            ))}
          </AnimatePresence>
        )}

        <div className="card" style={{ display: "grid", gap: 10 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <Sparkles size={18} color="var(--moss)" />
            <h3 style={{ margin: 0 }}>How the feed ranks right now</h3>
          </div>
          <p className="muted">
            For You prioritizes followed authors, your selected strands, fresh posts, and active discussions.
            Trending leans harder on reactions and comment volume. Latest stays purely chronological.
          </p>
        </div>
      </section>
    </>
  );
}
