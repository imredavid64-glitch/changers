    "check:local:type": "bash scripts/check-local.sh type-check",
    "check:local:lint": "bash scripts/check-local.sh lint",
    "check:local:build": "bash scripts/check-local.sh build",
    "build:analyze": "ANALYZE=true next build"
  },
  "dependencies": {
