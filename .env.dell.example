CHANGERS_DOMAIN=:80

HOST_MEDIA_ROOT=./.changers-media
HOST_POSTGRES_DATA=./postgres-data

POSTGRES_DB=changers
POSTGRES_USER=changers
POSTGRES_PASSWORD=change_this_to_a_long_random_password

# Set to http://YOUR_DELL_LAN_IP:8080/v1 in production
# (localhost won't work from inside the web container)
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost:8080/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=changers
NEXT_PUBLIC_APPWRITE_MEDIA_BUCKET_ID=changers-media

# Server-side Appwrite API key (used by /api/digest, /api/setup-admin, /api/badges/check)
APPWRITE_API_KEY=

NEXT_PUBLIC_APPWRITE_COLLECTION_PROFILES=profiles
NEXT_PUBLIC_APPWRITE_COLLECTION_POSTS=posts
NEXT_PUBLIC_APPWRITE_COLLECTION_COMMENTS=comments
NEXT_PUBLIC_APPWRITE_COLLECTION_NOTIFICATIONS=notifications
NEXT_PUBLIC_APPWRITE_COLLECTION_FOLLOWS=follows
NEXT_PUBLIC_APPWRITE_COLLECTION_SAVED_POSTS=saved-posts
NEXT_PUBLIC_APPWRITE_COLLECTION_ROOMS=rooms
NEXT_PUBLIC_APPWRITE_COLLECTION_ROOM_MESSAGES=room-messages
NEXT_PUBLIC_APPWRITE_COLLECTION_THREADS=threads
NEXT_PUBLIC_APPWRITE_COLLECTION_THREAD_MESSAGES=thread-messages
NEXT_PUBLIC_APPWRITE_COLLECTION_BLOCKS=blocks
NEXT_PUBLIC_APPWRITE_COLLECTION_PRIVACY_SETTINGS=privacy-settings
NEXT_PUBLIC_APPWRITE_COLLECTION_PROJECTS=projects
NEXT_PUBLIC_APPWRITE_COLLECTION_PROJECT_MEMBERS=project-members
NEXT_PUBLIC_APPWRITE_COLLECTION_EVENTS=events
NEXT_PUBLIC_APPWRITE_COLLECTION_EVENT_RSVPS=event-rsvps

MEDIA_MAX_UPLOAD_BYTES=26214400
MEDIA_FREE_SPACE_GUARD_BYTES=21474836480
