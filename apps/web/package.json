{
  "name": "changemakers-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --port 4400",
    "dev:demo": "DEMO_MODE=1 next dev -H 127.0.0.1 --port 4400",
    "build": "next build",
    "preview": "DEMO_MODE=1 npm run build && DEMO_MODE=1 next start -H 127.0.0.1 --port 4401",
    "preview:launch": "npm run build && next start -H 127.0.0.1 --port 4401",
    "start": "next start -H 127.0.0.1 --port 4401",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/vendor-maplibre.mjs",
    "map-data": "node scripts/map-data.mjs",
    "test:rls": "vitest run supabase/tests/rls",
    "test:rls:local": "node supabase/tests/local/rls.mjs && node supabase/tests/local/seed-check.mjs",
    "dev:code": "tsx scripts/dev-code.ts",
    "seed:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-dev.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "cobe": "^2.0.1",
    "lenis": "^1.3.26",
    "lucide-react": "1.48.0",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.7",
    "next-intl": "4.14.8",
    "pmtiles": "^4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
